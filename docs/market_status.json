import json
import logging
from logging.handlers import RotatingFileHandler
from datetime import datetime, timezone
import os


# ==========================================
# 1. كلاس إدارة التنبيهات (Alert Manager)
# ==========================================
class AlertManager:
    """
    مسؤول عن حفظ أحدث التنبيهات والصفقات النشطة في ملف market_status.json
    وأرشفة كافة التنبيهات والصفقات في ملف alerts.log منفصل تماماً.
    """
    def __init__(self, status_file="market_status.json", log_file="alerts.log", max_active_alerts=10):
        self.status_file = status_file
        self.max_active_alerts = max_active_alerts
        
        # إعداد ملف الأرشيف الجانبي التلقائي (Log Rotation)
        self.logger = logging.getLogger("AlertLogger")
        self.logger.setLevel(logging.INFO)
        
        if not self.logger.handlers:
            handler = RotatingFileHandler(
                log_file, 
                maxBytes=5 * 1024 * 1024, # 5MB
                backupCount=3, 
                encoding="utf-8"
            )
            formatter = logging.Formatter('[%(asctime)s] [%(levelname)s] %(message)s')
            handler.setFormatter(formatter)
            self.logger.addHandler(handler)

    def send_alert(self, alert_type: str, symbol: str, timeframe: str, message: str, extra_data: dict = None):
        """دالة إرسال وتسجيل التنبيهات"""
        timestamp = datetime.now(timezone.utc).isoformat()
        
        alert_payload = {
            "timestamp": timestamp,
            "type": alert_type,
            "symbol": symbol,
            "timeframe": timeframe,
            "message": message,
            "details": extra_data or {}
        }

        # أ) أرشفة في ملف alerts.log
        self.logger.info(f"[{symbol}] [{timeframe}] {alert_type}: {message}")

        # ب) تحديث ملف market_status.json
        self._update_market_status(new_alert=alert_payload)

    def update_trades_in_status(self, open_trades: list, closed_trades_history: list = None):
        """تحديث قسم الصفقات فقط داخل ملف market_status.json دون مسح التنبيهات"""
        status_data = self._read_status_file()
        status_data["open_trades"] = open_trades
        status_data["open_trades_count"] = len(open_trades)
        if closed_trades_history is not None:
            # الاحتفاظ بأحدث 5 صفقات مغلقة فقط للحفاظ على خفة الملف
            status_data["recent_closed_trades"] = closed_trades_history[-5:]
        
        status_data["last_updated"] = datetime.now(timezone.utc).isoformat()
        self._write_status_file(status_data)

    def _read_status_file(self) -> dict:
        default_data = {
            "last_updated": datetime.now(timezone.utc).isoformat(),
            "active_alerts_count": 0,
            "recent_alerts": [],
            "open_trades_count": 0,
            "open_trades": [],
            "recent_closed_trades": []
        }
        if os.path.exists(self.status_file):
            try:
                with open(self.status_file, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception:
                pass
        return default_data

    def _write_status_file(self, status_data: dict):
        with open(self.status_file, "w", encoding="utf-8") as f:
            json.dump(status_data, f, ensure_ascii=False, indent=4)

    def _update_market_status(self, new_alert: dict):
        status_data = self._read_status_file()
        recent_alerts = status_data.get("recent_alerts", [])
        recent_alerts.insert(0, new_alert)

        # حصر التنبيهات النشطة (Ring Buffer)
        status_data["recent_alerts"] = recent_alerts[:self.max_active_alerts]
        status_data["active_alerts_count"] = len(status_data["recent_alerts"])
        status_data["last_updated"] = new_alert["timestamp"]

        self._write_status_file(status_data)


# ==========================================
# 2. كلاس إدارة الصفقات (Trade Manager)
# ==========================================
class TradeManager:
    """
    مسؤول عن إدارة دورة حياة الصفقة: الفتح، المتابعة، الإغلاق (TP/SL)، وحساب الأرباح.
    """
    def __init__(self, alert_manager: AlertManager):
        self.alert_manager = alert_manager
        self.open_trades = []
        self.closed_trades = []

    def open_trade(self, symbol: str, side: str, entry_price: float, tp_price: float, sl_price: float, amount: float):
        """فتح صفقة جديدة وحساب نسبة المخاطرة"""
        trade_id = f"{symbol}_{side}_{int(datetime.now().timestamp())}"
        
        trade = {
            "trade_id": trade_id,
            "symbol": symbol,
            "side": side,  # "BUY" أو "SELL"
            "entry_price": entry_price,
            "take_profit": tp_price,
            "stop_loss": sl_price,
            "amount": amount,
            "status": "OPEN",
            "opened_at": datetime.now(timezone.utc).isoformat()
        }
        
        self.open_trades.append(trade)
        
        # إرسال تنبيه بالصفقة وتحديث ملف الحالة
        msg = f"🚀 فتح صفقة جديدة [{side}]: {symbol} بسعر {entry_price}$ | TP: {tp_price}$ | SL: {sl_price}$"
        self.alert_manager.send_alert("TRADE_OPENED", symbol, "EXECUTION", msg, trade)
        self.alert_manager.update_trades_in_status(self.open_trades, self.closed_trades)
        return trade

    def update_and_check_trades(self, current_prices: dict):
        """
        فحص الأسعار الحالية وإغلاق الصفقات تلقائياً عند ضرب الهدف أو الستوب
        current_prices: dictionary مثل {"ATOM-USDT": 1.42, "BTC-USDT": 65000}
        """
        for trade in self.open_trades[:]:
            symbol = trade["symbol"]
            if symbol not in current_prices:
                continue

            current_price = current_prices[symbol]
            side = trade["side"]

            # 1. فحص تحقيق الهدف (Take Profit)
            hit_tp = (side == "BUY" and current_price >= trade["take_profit"]) or \
                     (side == "SELL" and current_price <= trade["take_profit"])

            # 2. فحص ضرب وقف الخسارة (Stop Loss)
            hit_sl = (side == "BUY" and current_price <= trade["stop_loss"]) or \
                     (side == "SELL" and current_price >= trade["stop_loss"])

            if hit_tp:
                self._close_trade(trade, current_price, reason="TAKE_PROFIT")
            elif hit_sl:
                self._close_trade(trade, current_price, reason="STOP_LOSS")

    def _close_trade(self, trade: dict, exit_price: float, reason: str):
        """إغلاق الصفقة وحساب الأرباح/الخسائر النسبة والتناسب"""
        trade["exit_price"] = exit_price
        trade["closed_at"] = datetime.now(timezone.utc).isoformat()
        trade["status"] = f"CLOSED_{reason}"

        # حساب نسبة الربح / الخسارة PnL %
        if trade["side"] == "BUY":
            pnl_pct = ((exit_price - trade["entry_price"]) / trade["entry_price"]) * 100
        else:
            pnl_pct = ((trade["entry_price"] - exit_price) / trade["entry_price"]) * 100

        trade["pnl_pct"] = round(pnl_pct, 2)

        # نقل الصفقة للمغلقة
        self.open_trades.remove(trade)
        self.closed_trades.append(trade)

        # التنبيه بالإغلاق
        icon = "🎯" if reason == "TAKE_PROFIT" else "🛑"
        msg = f"{icon} إغلاق صفقة {trade['symbol']} السبب: {reason} | سعر الخروج: {exit_price}$ | النتيجة: {trade['pnl_pct']}%"
        
        self.alert_manager.send_alert("TRADE_CLOSED", trade['symbol'], "EXECUTION", msg, trade)
        self.alert_manager.update_trades_in_status(self.open_trades, self.closed_trades)


# ==========================================
# 3. كلاس البوت التشغيلي (Trading Bot)
# ==========================================
class TradingBot:
    def __init__(self):
        self.alert_manager = AlertManager(max_active_alerts=10)
        self.trade_manager = TradeManager(self.alert_manager)

    def run_cycle(self):
        """دورة عمل محاكاة للبوت"""
        
        # 1. فتح صفقة جديدة بناءً على إشارة
        print("--- 1. فتح صفقة جديدة ---")
        self.trade_manager.open_trade(
            symbol="ATOM-USDT",
            side="BUY",
            entry_price=1.350,
            tp_price=1.450,
            sl_price=1.300,
            amount=100
        )

        # 2. محاكاة وصول أسطر أسعار جديدة (ضرب الهدف)
        print("\n--- 2. تحديث الأسعار ومراقبة الصفقات ---")
        simulated_prices = {"ATOM-USDT": 1.460} # السعر تجاوز الـ TP (1.450$)
        self.trade_manager.update_and_check_trades(simulated_prices)


# ==========================================
# 4. التشغيل
# ==========================================
if __name__ == "__main__":
    bot = TradingBot()
    bot.run_cycle()
    print("\nتم تنفيذ دورة التداول وتحديث ملف market_status.json و alerts.log بنجاح!")
